    "signal"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "key": {
     "type": "string",
     "description": "policy:fr:<document number> for the Federal Register, else policy:<page key>."
    },
    "headline": {
     "type": "string"
    },
    "title": {
     "type": "string",
     "description": "The document's own title."
    },
    "harder": {
     "type": "string"
    },
    "who": {
     "type": "string"
    },
    "why": {
     "type": "string"
    },
    "limits": {
     "type": "string"
    },
    "status": {
     "$ref": "#/$defs/constraint_fields/properties/status"
    },
    "instrument": {
     "$ref": "#/$defs/constraint_fields/properties/instrument"
    },
    "layers": {
     "$ref": "#/$defs/constraint_fields/properties/layers"
    },
    "jurisdiction": {
     "type": "string"
    },
    "issuer": {
     "type": "string"
    },
    "effective": {
     "type": [
      "string",
      "null"
     ]
    },
    "comment_deadline": {
     "type": [
      "string",
      "null"
     ]
    },
    "access_now": {
     "type": "boolean"
    },
    "impact": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5
    },
    "ripples": {
     "type": "array"
    },
    "hats": {
     "type": "object"
    },
    "url": {
     "type": "string",
     "format": "uri"
    },
    "doc_url": {
     "type": "string",
     "format": "uri"
    },
    "primary": {
     "type": "boolean"
    },
    "sources": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string"
       },
       "url": {
        "type": "string"
       },
       "title": {
        "type": "string"
       }
      }
     }
    },
    "first_seen": {
