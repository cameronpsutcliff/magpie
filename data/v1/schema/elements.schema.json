{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://www.cameronsutcliff.com/magpie-data/schema/elements.schema.json",
 "title": "Magpie element index (magpie.elements/1)",
 "description": "Every element page, most recently seen first. Fetch one with elements/<slug>.json; look one up by canonical key with the key field.",
 "type": "object",
 "required": [
  "schema",
  "updated",
  "elements"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "magpie.elements/1"
  },
  "updated": {
   "type": [
    "string",
    "null"
   ],
   "format": "date"
  },
  "elements": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "slug",
     "key",
     "kind",
     "name",
     "topics",
     "first_seen",
     "last_seen",
     "days_seen",
     "days_featured",
     "possibilities",
     "constraints",
     "dates"
    ],
    "properties": {
     "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
     },
     "key": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "headline": {
      "type": "string"
     },
     "maker": {
      "type": "string"
     },
     "topics": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "first_seen": {
      "type": "string",
      "format": "date"
     },
     "last_seen": {
      "type": "string",
      "format": "date"
     },
     "days_seen": {
      "type": "integer",
      "minimum": 1
     },
     "days_featured": {
      "type": "integer",
      "minimum": 0
     },
     "best_impact": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
     },
     "possibilities": {
      "type": "integer",
      "minimum": 0
     },
     "constraints": {
      "type": "integer",
      "minimum": 0
     },
     "dates": {
      "type": "array",
      "items": {
       "type": "string",
       "format": "date"
      },
      "description": "Editions in the page's timeline window and its possibilities, newest first."
     }
    },
    "additionalProperties": false
   }
  }
 }
}
